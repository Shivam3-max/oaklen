# Copy this file to .env (local) — never commit the real .env.
# On Hostinger, set each of these in your Node.js app's Environment Variables.

# ---- Database (REQUIRED to save products, images and bookings) ----
# From Hostinger (hPanel -> Databases -> MySQL Databases).
# Host is usually "localhost" on Hostinger web hosting. Special characters
# in the password are fine — they are encoded automatically.
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME=""
DB_USER=""
DB_PASSWORD=""

# ---- Admin panel (REQUIRED — set a strong passcode) ----
# The passcode for /admin. Locally it defaults to "oaklen2026"; in production
# /admin stays locked until this is set.
OAKLEN_ADMIN_KEY=""

# ---- Site URL (REQUIRED in production) ----
# The live address, no trailing slash. Used for SEO, sitemap and canonical
# links; read at build time, so redeploy after changing it.
NEXT_PUBLIC_SITE_URL="https://oaklen.in"

# ---- Email (optional — booking + enquiry notifications) ----
# From resend.com. EMAIL_FROM must be a verified sender on your domain.
RESEND_API_KEY=""
EMAIL_FROM="Oaklen <care@oaklen.in>"
# Where new-booking and enquiry alerts are sent (defaults to the brand email).
EMAIL_STAFF=""

# ---- Analytics (optional) ----
# Google Analytics 4 measurement id, e.g. G-XXXXXXX.
NEXT_PUBLIC_GA_ID=""
